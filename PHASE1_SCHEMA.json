{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CSE2101_Phase1_Corpus_Schema",
  "description": "Authoritative machine-readable schema for Phase 1.1 Source Corpus Audit & Ingestion deliverables.",
  "definitions": {
    "Document": {
      "type": "object",
      "required": [
        "document_id",
        "filename",
        "relative_path",
        "file_size",
        "sha256",
        "page_count",
        "document_classification",
        "source_tier",
        "classification_confidence",
        "content_type",
        "text_extraction_status"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^DOC-\\d{2}$"
        },
        "filename": {
          "type": "string"
        },
        "relative_path": {
          "type": "string"
        },
        "file_size": {
          "type": "integer"
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "page_count": {
          "type": "integer"
        },
        "document_classification": {
          "type": "string",
          "enum": [
            "University Examination Paper",
            "Backlog / Special Examination Paper",
            "Official / Institutional Question Bank",
            "Question Bank — Authority Unconfirmed",
            "Objective Question Bank — Authority Unconfirmed",
            "Practice / Problem Set",
            "Assignment",
            "Solution Document / Answer Key",
            "Notes / Study Material",
            "Mixed Academic Document",
            "Unknown / Needs Review"
          ]
        },
        "source_tier": {
          "type": "integer",
          "enum": [1, 2, 3, 4]
        },
        "classification_confidence": {
          "type": "string",
          "enum": ["HIGH", "MEDIUM", "FLAGGED"]
        },
        "classification_evidence": {
          "type": "string"
        },
        "content_type": {
          "type": "string",
          "enum": [
            "question-bearing",
            "solution-bearing",
            "mixed",
            "non-question academic material"
          ]
        },
        "apparent_year": {
          "type": ["integer", "null"]
        },
        "apparent_branch": {
          "type": ["string", "null"]
        },
        "apparent_semester": {
          "type": ["string", "null"]
        },
        "apparent_exam_type": {
          "type": ["string", "null"],
          "enum": ["Regular", "Backlog", "Supplementary", null]
        },
        "apparent_course_id": {
          "type": ["string", "null"]
        },
        "apparent_course_name": {
          "type": ["string", "null"]
        },
        "apparent_time_allotted": {
          "type": ["string", "null"]
        },
        "apparent_full_marks": {
          "type": ["string", "null"]
        },
        "text_extraction_status": {
          "type": "string",
          "enum": ["SUCCESS", "SCANNED_IMAGE_ONLY", "MINIMAL_TEXT"]
        },
        "duplicate_group": {
          "type": ["string", "null"]
        },
        "is_duplicate_of": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        }
      }
    },
    "PaperQuestionContainer": {
      "type": "object",
      "required": [
        "record_type",
        "question_instance_id",
        "document_id",
        "source_file",
        "page_start",
        "page_end",
        "group_or_section",
        "official_question_number",
        "container_title",
        "child_question_instance_ids",
        "is_student_answerable",
        "marks_status"
      ],
      "properties": {
        "record_type": {
          "type": "string",
          "const": "paper_question_container"
        },
        "occurrence_type": {
          "type": "null"
        },
        "question_instance_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "page_start": {
          "type": "integer"
        },
        "page_end": {
          "type": "integer"
        },
        "group_or_section": {
          "type": "string"
        },
        "official_question_number": {
          "type": "string"
        },
        "sub_question_id": {
          "type": "null"
        },
        "parent_question_container_id": {
          "type": "null"
        },
        "child_question_instance_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "container_title": {
          "type": "string"
        },
        "raw_text": {
          "type": "null"
        },
        "wording_state": {
          "type": "null"
        },
        "wording_status": {
          "type": "null"
        },
        "reconstruction_metadata": {
          "type": "null"
        },
        "completeness_status": {
          "type": "string",
          "enum": ["COMPLETE", "INCOMPLETE"]
        },
        "extraction_confidence": {
          "type": "string",
          "enum": ["HIGH", "MEDIUM", "FLAGGED"]
        },
        "source_tier": {
          "type": "integer"
        },
        "source_type": {
          "type": "string"
        },
        "source_established_metadata": {
          "type": "object"
        },
        "marks": {
          "type": "null"
        },
        "marks_status": {
          "type": "string",
          "const": "container_aggregate_unallocated"
        },
        "has_diagram_or_image": {
          "type": "boolean",
          "const": false
        },
        "source_visual_required": {
          "type": "boolean",
          "const": false
        },
        "source_visual_page": {
          "type": "null"
        },
        "source_visual_region": {
          "type": "null"
        },
        "source_visual_reason": {
          "type": "null"
        },
        "is_student_answerable": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "QuestionOccurrence": {
      "type": "object",
      "required": [
        "record_type",
        "occurrence_type",
        "question_instance_id",
        "document_id",
        "source_file",
        "page_start",
        "page_end",
        "group_or_section",
        "official_question_number",
        "raw_text",
        "wording_state",
        "wording_status",
        "completeness_status",
        "extraction_confidence",
        "source_tier",
        "source_type",
        "source_established_metadata",
        "marks_status",
        "has_diagram_or_image",
        "source_visual_required",
        "is_student_answerable"
      ],
      "properties": {
        "record_type": {
          "type": "string",
          "const": "question_occurrence"
        },
        "occurrence_type": {
          "type": "string",
          "enum": ["sub_question", "standalone"]
        },
        "question_instance_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "page_start": {
          "type": "integer"
        },
        "page_end": {
          "type": "integer"
        },
        "group_or_section": {
          "type": "string"
        },
        "official_question_number": {
          "type": "string"
        },
        "sub_question_id": {
          "type": ["string", "null"]
        },
        "parent_question_container_id": {
          "type": ["string", "null"]
        },
        "raw_text": {
          "type": "string"
        },
        "wording_state": {
          "type": "string",
          "enum": [
            "STATE A — EXACT",
            "STATE B — RECONSTRUCTED",
            "STATE C — SOURCE-INCOMPLETE"
          ]
        },
        "wording_status": {
          "type": "string",
          "enum": [
            "exact_source",
            "reconstructed_from_source",
            "incomplete_source"
          ]
        },
        "reconstruction_metadata": {
          "type": ["object", "null"],
          "properties": {
            "reconstruction_method": { "type": "string" },
            "visual_source_reference": { "type": "string" },
            "reconstructed_text": { "type": "string" },
            "reconstruction_confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
          }
        },
        "completeness_status": {
          "type": "string",
          "enum": ["COMPLETE", "INCOMPLETE"]
        },
        "extraction_confidence": {
          "type": "string",
          "enum": ["HIGH", "MEDIUM", "FLAGGED"]
        },
        "source_tier": {
          "type": "integer",
          "enum": [1, 2, 3, 4]
        },
        "source_type": {
          "type": "string"
        },
        "source_established_metadata": {
          "type": "object",
          "properties": {
            "year": { "type": ["integer", "null"] },
            "branch": { "type": ["string", "null"] },
            "semester": { "type": ["string", "null"] },
            "course_code": { "type": ["string", "null"] },
            "course_name": { "type": ["string", "null"] },
            "exam_type": { "type": ["string", "null"], "enum": ["Regular", "Backlog", "Supplementary", null] },
            "time_allotted": { "type": ["string", "null"] },
            "full_marks": { "type": ["string", "null"] }
          }
        },
        "marks": {
          "type": ["string", "null"]
        },
        "marks_status": {
          "type": "string",
          "enum": ["physically_established", "not_specified"]
        },
        "has_diagram_or_image": {
          "type": "boolean"
        },
        "source_visual_required": {
          "type": "boolean"
        },
        "source_visual_page": {
          "type": ["integer", "null"]
        },
        "source_visual_region": {
          "type": ["string", "null"]
        },
        "source_visual_reason": {
          "type": ["string", "null"]
        },
        "is_student_answerable": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "Record": {
      "oneOf": [
        { "$ref": "#/definitions/PaperQuestionContainer" },
        { "$ref": "#/definitions/QuestionOccurrence" }
      ]
    },
    "PageAudit": {
      "type": "object",
      "required": [
        "document_id",
        "filename",
        "relative_path",
        "page_number",
        "character_count",
        "text_extraction_status",
        "text_extraction_confidence",
        "visual_inspection_required",
        "visual_verification_status",
        "overall_confidence",
        "ocr_used",
        "ocr_recommended",
        "unreadable_area",
        "raster_images_count",
        "vector_drawings_count",
        "diagram_present",
        "table_present",
        "equation_or_formula_present"
      ],
      "properties": {
        "document_id": { "type": "string" },
        "filename": { "type": "string" },
        "relative_path": { "type": "string" },
        "page_number": { "type": "integer" },
        "character_count": { "type": "integer" },
        "text_extraction_status": { "type": "string" },
        "text_extraction_confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "visual_inspection_required": { "type": "boolean" },
        "visual_verification_status": { "type": "string", "enum": ["NOT_REQUIRED", "REQUIRED", "VERIFIED", "FLAGGED"] },
        "overall_confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "FLAGGED"] },
        "ocr_used": { "type": "boolean" },
        "ocr_recommended": { "type": "boolean" },
        "unreadable_area": { "type": "boolean" },
        "raster_images_count": { "type": "integer" },
        "vector_drawings_count": { "type": "integer" },
        "diagram_present": { "type": "boolean" },
        "table_present": { "type": "boolean" },
        "equation_or_formula_present": { "type": "boolean" }
      }
    },
    "VisualVerificationRecord": {
      "type": "object",
      "required": [
        "document_id",
        "filename",
        "page_number",
        "visual_element_type",
        "raster_images_count",
        "vector_drawings_count",
        "table_present",
        "visual_inspection_required",
        "visual_verification_status",
        "inspection_notes"
      ],
      "properties": {
        "document_id": { "type": "string" },
        "filename": { "type": "string" },
        "page_number": { "type": "integer" },
        "visual_element_type": { "type": "string" },
        "raster_images_count": { "type": "integer" },
        "vector_drawings_count": { "type": "integer" },
        "table_present": { "type": "boolean" },
        "visual_inspection_required": { "type": "boolean" },
        "visual_verification_status": { "type": "string", "enum": ["NOT_REQUIRED", "REQUIRED", "VERIFIED", "FLAGGED"] },
        "inspection_notes": { "type": "string" }
      }
    },
    "SuspiciousExtractionRecord": {
      "type": "object",
      "required": [
        "question_instance_id",
        "document_id",
        "page",
        "issues",
        "text_snippet"
      ],
      "properties": {
        "question_instance_id": { "type": "string" },
        "document_id": { "type": "string" },
        "page": { "type": "integer" },
        "issues": { "type": "array", "items": { "type": "string" } },
        "text_snippet": { "type": "string" }
      }
    },
    "DamageAudit": {
      "type": "object",
      "required": [
        "question_instance_id",
        "document_id",
        "page",
        "source_file",
        "visible_content",
        "missing_component",
        "exclusion_reason",
        "severity",
        "complete_occurrence_exists_elsewhere"
      ],
      "properties": {
        "question_instance_id": { "type": "string" },
        "document_id": { "type": "string" },
        "page": { "type": "integer" },
        "source_file": { "type": "string" },
        "visible_content": { "type": "string" },
        "missing_component": { "type": "string" },
        "exclusion_reason": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["FATAL", "HIGH", "MEDIUM"]
        },
        "complete_occurrence_exists_elsewhere": { "type": "boolean" }
      }
    }
  }
}